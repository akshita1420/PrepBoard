# Copy to .env on the VPS (never commit .env) and fill in.

# The site's address. Point this name at the VPS's IP with a DNS "A" record first.
DOMAIN=prepboard.aravindc.dev

# Database (any long random password)
DB_USERNAME=prepboard
DB_PASSWORD=change-me-to-a-long-random-password

# Browser push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email reminders (optional): a Gmail address + Gmail App Password
MAIL_USERNAME=
MAIL_PASSWORD=

# Ports on the VPS. Keep 80/443 unless another web server (nginx, Apache, Caddy) already uses them;
# then pick free ones (e.g. 8088/8443) and point that web server at http://127.0.0.1:8088 (see DEPLOY.md).
HTTP_PORT=80
HTTPS_PORT=443
